+def _latent_cache_root(value: str) -> Path:
+    """Persistent cache independent of instance startup/shutdown cleanup."""
+    fp = _folder_paths()
+    base = Path(fp.base_path).resolve()
+    value = value.strip().strip('"')
+    cache = Path(value) if value else base / "training_cache" / "yue2_latents"
+    if not cache.is_absolute():
+        cache = base / cache
+    cache = cache.resolve()
+    # Reject both the active instance temp and the legacy shared temp tree.
+    for temp in (Path(fp.get_temp_directory()).resolve(), base / "temp"):
+        if cache == temp or cache.is_relative_to(temp):
+            raise ValueError("cache_folder must be outside ComfyUI temp directories; "
+                             "leave empty for the persistent training_cache/yue2_latents default")
+    return cache
+

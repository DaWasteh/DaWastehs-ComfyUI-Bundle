+def _load_audio_ffmpeg(path: Path) -> tuple[torch.Tensor, int]:
+    """Last-resort CPU decoder; no TorchCodec/CUDA dependency or shell quoting."""
+    executable = shutil.which("ffmpeg")
+    if executable is None:
+        try:
+            import imageio_ffmpeg
+            executable = imageio_ffmpeg.get_ffmpeg_exe()
+        except (ImportError, RuntimeError) as exc:
+            raise RuntimeError("Install FFmpeg on PATH or imageio-ffmpeg in the ComfyUI venv") from exc
+    from .train import _check_interrupt
+    # File-backed stdout avoids a second full-song pipe buffer in RAM. Keep
+    # diagnostics bounded when reporting a damaged file; never modify its source.
+    with tempfile.TemporaryFile() as pcm, tempfile.TemporaryFile() as errors:
+        command = [executable, "-hide_banner", "-loglevel", "error", "-nostdin",
+                   "-i", str(path.resolve()), "-map", "0:a:0", "-vn", "-sn", "-dn",
+                   "-ac", "2", "-ar", str(SAMPLE_RATE), "-f", "f32le", "pipe:1"]
+        process = subprocess.Popen(command, stdout=pcm, stderr=errors,
+                                   creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0))
+        deadline = time.monotonic() + 600
+        try:
+            while True:
+                _check_interrupt()
+                if time.monotonic() >= deadline:
+                    raise TimeoutError(f"FFmpeg decode exceeded 600 seconds: {path}")
+                try:
+                    code = process.wait(timeout=0.25)
+                    break
+                except subprocess.TimeoutExpired:
+                    pass
+        finally:
+            if process.poll() is None:
+                process.kill()
+                process.wait()
+        errors.seek(0)
+        diagnostic = errors.read(4096).decode("utf-8", errors="replace").strip()
+        if code != 0:
+            raise RuntimeError(f"FFmpeg exit {code}: {diagnostic}")
+        if diagnostic:
+            log.warning("FFmpeg recovered audio errors in %s: %s", path, diagnostic)
+        size = pcm.tell()
+        if not size or size % 8:
+            raise ValueError(f"FFmpeg returned empty/misaligned stereo PCM: {path}")
+        pcm.seek(0)
+        data = np.fromfile(pcm, dtype="<f4").reshape(-1, 2)
+    return torch.from_numpy(data.T.copy()), SAMPLE_RATE
+

{
  "name": "E8_ckattn",
  "description": "E8: comfy-kitchen INT8 attention (quality trade-off, opt-in) (replaces --use-pytorch-cross-attention: the two flags are mutually exclusive in cli_args)",
  "env": {
    "HIP_VISIBLE_DEVICES": "0,1",
    "CUDA_VISIBLE_DEVICES": "0,1",
    "TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL": "1",
    "TORCH_BLAS_PREFER_HIPBLASLT": "1",
    "OMP_NUM_THREADS": "24",
    "MKL_NUM_THREADS": "24",
    "OPENBLAS_NUM_THREADS": "24",
    "NUMEXPR_NUM_THREADS": "24",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "unset_env": [
    "TORCH_BLAS_PREFER_CUBLASLT",
    "DISABLE_ADDMM_CUDA_LT",
    "HSA_OVERRIDE_GFX_VERSION",
    "PYTORCH_TUNABLEOP_ENABLED"
  ],
  "args": [
    "--default-device",
    "0",
    "--reserve-vram",
    "4",
    "--disable-dynamic-vram",
    "--disable-async-offload",
    "--disable-pinned-memory",
    "--cache-ram",
    "--use-ck-attention"
  ]
}
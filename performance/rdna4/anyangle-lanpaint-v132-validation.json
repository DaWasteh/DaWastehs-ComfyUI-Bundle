 "findings": [
  {
   "topic": "Render Splat (ComfyUI 0.38 core) on ROCm",
   "observed": "torch.AcceleratorError: CUDA error: invalid configuration argument (hipErrorInvalidConfiguration) in comfy_extras/nodes_gaussian_splat.py _render_gaussian: si = torch.linalg.inv(cam_cov) with 262144 gaussians; 32768 gaussians render in 1.8 s",
   "cause": "PyTorch 2.13 + ROCm 10.1: a batched torch.linalg.inv of 3x3 matrices fails above 65535 matrices per call (60000 ok, 70000 fails)",
   "fix": "custom_nodes/ComfyUI-DaWasteh-MultiGPU-Control/splat_inverse.py gives the core gaussian-splat module a torch whose linalg.inv/eigh/det run in chunks of 32768 (same values); DAWASTEH_SPLAT_LINALG_FIX=0 turns it off"
  },
  {
   "topic": "AnyAngle LoRA model card names the images the other way round",
   "observed": "with <image1> = coarse render and <image2> = original all four outputs showed the unchanged front view",
   "cause": "the LoRA works with the original as the first reference image",
   "fix": "TextEncodeQwenImage21: image_1 = original, image_2 = render in all AnyAngle workflows; pinned by tests/test_anyangle_lanpaint_v132.py"
  },
  {
   "topic": "AnyAngle Studio requirements.txt",
   "observed": "it names onnxruntime; the bundle environment has onnxruntime-directml (same module)",
   "cause": "pip would install the plain wheel over the DirectML build used by the live avatar workflows",
   "fix": "the updater tracks the pack from GitHub without installing its requirements; OpenCV and huggingface_hub are already present"
  }
 ]

{
 "1": {
  "_meta": {
   "title": "Dataset aus ComfyUI input"
  },
  "class_type": "LoadImageTextDataSetFromFolder",
  "inputs": {
   "folder": "lora_training/_rdna4_bench"
  }
 },
 "2": {
  "_meta": {
   "title": "Dataset-Vorschau"
  },
  "class_type": "PreviewImage",
  "inputs": {
   "images": [
    "1",
    0
   ]
  }
 },
 "20": {
  "_meta": {
   "title": "SelectModelDevice · central control"
  },
  "class_type": "SelectModelDevice",
  "inputs": {
   "device": [
    "23",
    0
   ],
   "model": [
    "3",
    0
   ]
  }
 },
 "21": {
  "_meta": {
   "title": "SelectCLIPDevice · central control"
  },
  "class_type": "SelectCLIPDevice",
  "inputs": {
   "clip": [
    "3",
    1
   ],
   "device": [
    "23",
    1
   ]
  }
 },
 "22": {
  "_meta": {
   "title": "SelectVAEDevice · central control"
  },
  "class_type": "SelectVAEDevice",
  "inputs": {
   "device": [
    "23",
    2
   ],
   "vae": [
    "3",
    2
   ]
  }
 },
 "23": {
  "_meta": {
   "title": "Central GPU Control · MODEL / CLIP / VAE"
  },
  "class_type": "DaWMultiGPUDeviceControl",
  "inputs": {
   "clip_device": "gpu:0",
   "model_device": "gpu:0",
   "vae_device": "gpu:0"
  }
 },
 "3": {
  "_meta": {
   "title": "Load Checkpoint"
  },
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "SDXL\\RealVisXL_V4.0.safetensors"
  }
 },
 "4": {
  "_meta": {
   "title": "Make Training Dataset"
  },
  "class_type": "MakeTrainingDataset",
  "inputs": {
   "clip": [
    "21",
    0
   ],
   "images": [
    "1",
    0
   ],
   "texts": [
    "1",
    1
   ],
   "vae": [
    "22",
    0
   ]
  }
 },
 "5": {
  "_meta": {
   "title": "Resolution Bucket"
  },
  "class_type": "ResolutionBucket",
  "inputs": {
   "conditioning": [
    "4",
    1
   ],
   "latents": [
    "4",
    0
   ]
  }
 },
 "6": {
  "_meta": {
   "title": "Lokales LoRA-Training"
  },
  "class_type": "TrainLoraNode",
  "inputs": {
   "algorithm": "LoRA",
   "batch_size": 1,
   "bucket_mode": true,
   "bypass_mode": false,
   "checkpoint_depth": 1,
   "existing_lora": "[None]",
   "grad_accumulation_steps": 4,
   "gradient_checkpointing": true,
   "latents": [
    "5",
    0
   ],
   "learning_rate": 0.0001,
   "lora_dtype": "bf16",
   "loss_function": "MSE",
   "model": [
    "20",
    0
   ],
   "offloading": false,
   "optimizer": "AdamW",
   "positive": [
    "5",
    1
   ],
   "quantized_backward": false,
   "rank": 16,
   "seed": 42,
   "steps": 2,
   "training_dtype": "bf16"
  }
 },
 "7": {
  "_meta": {
   "title": "LossGraph anzeigen"
  },
  "class_type": "LossGraphNode",
  "inputs": {
   "filename_prefix": "lora_training/sdxl_loss",
   "loss": [
    "6",
    1
   ]
  }
 },
 "8": {
  "_meta": {
   "title": "LoRA lokal speichern"
  },
  "class_type": "SaveLoRA",
  "inputs": {
   "lora": [
    "6",
    0
   ],
   "prefix": "loras/rdna4_bench/TRAIN-SDXL_guard_depth1",
   "steps": [
    "6",
    2
   ]
  }
 },
 "9": {
  "_meta": {
   "title": "Run Timer Pixaroma"
  },
  "class_type": "PixaromaRunTimer",
  "inputs": {}
 }
}